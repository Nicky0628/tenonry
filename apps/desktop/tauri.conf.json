{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tenonry",
  "version": "0.1.0",
  "identifier": "app.tenonry.desktop",
  "mainBinaryName": "tenonry",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Tenonry",
        "create": false,
        "width": 1180,
        "height": 780,
        "minWidth": 880,
        "minHeight": 580,
        "center": true,
        "resizable": true,
        "decorations": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "capabilities": ["main-window"],
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": false,
    "shortDescription": "跨平台开发工具环境管理器",
    "category": "DeveloperTool",
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
